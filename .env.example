# ==============================================================================
# MarketMyIdea Admin Panel — Environment Variables Template
# ==============================================================================
# IMPORTANT:
# - NEXT_PUBLIC_ variables are exposed to the browser client.
# - Secret keys (SUPABASE_SERVICE_ROLE_KEY) are STRICTLY SERVER-SIDE.
# - In production (Cloudflare Workers), set secrets via `wrangler secret put <KEY>`.
# ==============================================================================

# Supabase Public API (Accessible by client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Server-Only Secret (NEVER prefix with NEXT_PUBLIC_)
# For local development: Set in .env.local
# For Cloudflare Worker: Run `npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY`
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Application Configuration
NEXT_PUBLIC_APP_NAME="MarketMyIdea Admin Panel"
NEXT_PUBLIC_ADMIN_HOST="admin.marketmyidea.online"

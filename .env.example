# ==============================================================================
# MarketMyIdea Admin Panel — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Standalone Admin Authentication (Required)
# ------------------------------------------------------------------------------
# The authorized administrator email address:
ADMIN_EMAIL=admin@marketmyidea.online

# The SHA-256 (or SHA-512) hex hash of the admin password.
# NEVER put plaintext passwords here!
# Generate hash via terminal:
#   echo -n "YourSecurePasswordHere" | sha256sum | awk '{print $1}'
ADMIN_PASSWORD_HASH=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Optional: A secret string used to sign HMAC-SHA256 session cookies.
# If omitted, a key is automatically derived from ADMIN_PASSWORD_HASH.
ADMIN_SESSION_SECRET=your-random-32-char-session-signing-secret

# Optional: Session duration in seconds (default: 86400 = 24 hours)
ADMIN_SESSION_MAX_AGE=86400

# ------------------------------------------------------------------------------
# 2. Supabase Database Integration (Optional / Server-Side Database Queries)
# ------------------------------------------------------------------------------
# Used exclusively for server-side database queries (orders, users, creators, disputes).
# In production (Cloudflare Workers), set secrets via `wrangler secret put <KEY>`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. Application Metadata
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="MarketMyIdea Admin Panel"
NEXT_PUBLIC_ADMIN_HOST="admin.marketmyidea.online"
